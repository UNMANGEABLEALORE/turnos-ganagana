# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# El archivo ".env" NO se sube a GitHub. En Render, estas mismas claves se escriben en Environment.

# Dirección pública del sitio (necesaria para entrar con Google / GitHub)
PUBLIC_URL=https://turnos-ganagana.onrender.com

# CAPTCHA real (https://www.hcaptcha.com). Sin esto funciona en modo de prueba.
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Entrar con Google (https://console.cloud.google.com → Credenciales → ID de cliente OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Entrar con GitHub (https://github.com/settings/developers → New OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Administrador principal (solo si NO usas administradores.json)
ADMIN_PRINCIPAL_USER=Ganaadmin
ADMIN_PRINCIPAL_NAME=Juan David Porras
ADMIN_PRINCIPAL_PASSWORD=
ADMIN_PRINCIPAL_EMAIL=
ADMIN_PRINCIPAL_GITHUB=

# Base de datos MySQL (XAMPP / MariaDB) donde se guardan los administradores.
# Si se dejan vacías, los administradores se guardan en server/data/store.json.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=turnos_app
MYSQL_PASSWORD=
MYSQL_DATABASE=turnos_ganagana
# MYSQL_SSL=true   ← solo para MySQL en la nube

# Opcional: clave para firmar sesiones (si se deja vacía se crea sola en sesion.secret)
SESSION_SECRET=
